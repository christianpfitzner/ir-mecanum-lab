# RViz2 view for Experiment 2 (state estimation) — robot "test".
#   rviz2 -d rviz/kf.rviz
#   ros2 launch launch/kf.launch.py aufgabe:=kf_fusion rviz:=true
# Andere Roboternamen in den drei Themenfeldern unter Displays anpassen (/test/... -> /name/...).
# Fixed Frame is map: GPS and your own estimate point there, and the simulator publishes the
# TF branch map -> test/odom -> test/base_link (plus laser and imu_link), so `map` really exists.
# Dark background so the marker colours stay readable on the dark floor of the simulator view.
Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Estimate1
      Splitter Ratio: 0.5
    Tree Height: 520
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.4
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 110; 110; 120
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Raster
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Angle Type: Yaw
      Class: rviz_default_plugins/Odometry
      Covariance: false
      Enabled: true
      Keep: 200
      Name: Odometrie
      Position Arrow:
        Alpha: 1
        Length: 1
        Scale: 0.15
      Shape:
        Alpha: 0.6
        Color: 80; 170; 255
        Offset Frame: test/base_link
        Shape: Arrow
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test/odom
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/Pose
      Color: 90; 220; 120
      Enabled: true
      Head Length: 0.2
      Head Radius: 0.1
      Name: GPS
      Shaft Length: 0.4
      Shaft Radius: 0.03
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test/gps
      Value: true
    - Alpha: 0.7
      Class: rviz_default_plugins/PoseWithCovariance
      Color: 235; 110; 70
      Covariance:
        Orientation:
          Alpha: 0.3
          Color: 255; 255; 120
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Head Length: 0.25
      Head Radius: 0.12
      Name: Estimate
      Shaft Length: 0.5
      Shaft Radius: 0.04
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /test/kf/pose
      Value: true
  Global Options:
    Background Color: 24; 26; 30
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 13.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 2
        Y: 1
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.2
      Target Frame: <Fixed Frame>
      Yaw: 1.57
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
