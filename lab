#!/usr/bin/env bash
# Entry point for both labs: ./lab <command> [options]
# Sets PYTHONPATH, adds ROS 2 when the machine offers it, and calls the node.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
export PYGAME_HIDE_SUPPORT_PROMPT=1   # no pygame banner in the students' terminal

if ! python3 -c "import pygame" >/dev/null 2>&1; then
  echo "pygame is missing — install it once:" >&2
  echo "  ./install.sh                       (recommended, also checks ROS and the tests)" >&2
  echo "  sudo apt install python3-pygame    (or: pip3 install --user pygame)" >&2
  exit 3
fi

# ROS 2 only when present; MECANUM_ROS=stub forces the in-process bus (no ROS needed).
# set +u is required: the ROS setup scripts read AMENT_* variables that the first
# source has not set yet — with `set -u` the launcher would die silently right here.
if [[ "${MECANUM_ROS:-}" != "stub" ]]; then
  set +u
  for f in "${ROS_SETUP:-}" "/opt/ros/${ROS_DISTRO:-kilted}/setup.bash" \
           /opt/ros/humble/setup.bash /opt/ros/jazzy/setup.bash /opt/ros/rolling/setup.bash; do
    if [[ -n "$f" && -f "$f" ]]; then
      # shellcheck disable=SC1090
      source "$f" 2>/dev/null && break
    fi
  done
  set -u
fi

case "${1:-}" in
  -h|--help|help|"")
    python3 -m mecanum_lab.node -h
    cat <<'HILFE'

Lab 1 examples (all of it without ROS, with pygame only):
  In the lab room the usual door is the launch file (simulator + your node + RViz at once):
    ros2 launch mecanum_lab lab.launch.py controller:=student/solution.py
  Everything below is the same simulator without ROS 2, on one process and one clock.
  ./lab run --robot alice --controller student/controller_template.py
      Simulator + your node in one process, with a window. Quit with q.
  ./lab run --robot alice --controller student/solution.py --world track --seconds 60
      The same with the reference solution.
  ./lab grade --robot alice --task v1 --json bericht.json
      Grade the lab 1 tasks; exit code 2 if not passed.

Lab 2 examples (state estimation / Kalman filter):
  ./lab run --world arena --task kf_gps --robot alice \
      --controller student/kf_template.py --truth
      Filter workbench with a window; the sim drives, you only estimate.
  ./lab grade --task kf_alle --controller student/kf_solution.py --log messung.csv
      Grade all KF tasks and record the measurement series for the lab report.
  ./lab run --world arena --task kf_fusion --set gps.sigma_xy=1.2 --set imu.rate=400
      Change the sensors freely — everything through --set, no JSON file needed.

ROS 2 operation:
  ./lab sim --world production --robots alice,bob --headless
  ./lab spawn --name carlo              # add a robot to a running simulation
  ./lab robots                          # what is driving right now?
  ros2 launch launch/kf.launch.py       # lab 2 fully configured (see --show-args)
  MECANUM_ROS=stub ./lab sim --headless --seconds 5      # deliberately without ROS
HILFE
    ;;
  *) exec python3 -m mecanum_lab.node "$@" ;;
esac
